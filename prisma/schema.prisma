generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  emailVerified           DateTime?
  password                String?
  image                   String?
  role                    Role                     @default(ANALYST)
  createdAt               DateTime                 @default(now())
  occurrences             Occurrence[]             @relation("AssignedTo")
  comments                Comment[]
  accounts                Account[]
  sessions                Session[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
}

enum Role {
  ADMIN
  ANALYST
}

model Occurrence {
  id          String          @id @default(cuid())
  title       String
  description String
  category    Category
  status      Status          @default(OPEN)
  latitude    Float
  longitude   Float
  address     String
  imageUrl    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  assignedTo  User?           @relation("AssignedTo", fields: [userId], references: [id])
  userId      String?
  comments    Comment[]
  history     StatusHistory[]
}

enum Category {
  POTHOLE
  GARBAGE
  LIGHTING
  OTHER
}

enum Status {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Comment {
  id           String     @id @default(cuid())
  content      String
  createdAt    DateTime   @default(now())
  author       User       @relation(fields: [authorId], references: [id])
  authorId     String
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id])
  occurrenceId String
}

model StatusHistory {
  id           String     @id @default(cuid())
  from         Status
  to           Status
  changedAt    DateTime   @default(now())
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id])
  occurrenceId String
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum NotificationType {
  OCCURRENCE_CREATED
  STATUS_CHANGED
  COMMENT_ADDED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType
  enabled Boolean          @default(true)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}
